{
    "name": "rikstone/php-cpe",
    "description": "A package that enables working with Common Platform Enumeration (CPE)",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Rikstone\\Cpe\\": "src/"
        }
    },
    "require": {
        "php": ">=8.4"
    },
    "autoload-dev": {
        "psr-4": {
            "Rikstone\\Cpe\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Sergey Kolevatov"
        }
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "phpunit": "php vendor/bin/phpunit tests"
    }
}
